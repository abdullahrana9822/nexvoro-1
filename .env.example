# Server-only Supabase project URL (used by the admin provisioner and server DB client)
SUPABASE_URL=

# Public Supabase project URL and publishable/anon key (browser auth + public reads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service key. Never use the service-role key in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Signs database-verified, HttpOnly Super Admin sessions. Generate a random value of at least 32 characters.
SESSION_SECRET=

# Admin usernames and bcrypt password hashes live in public.nexvoro_admin_users; do not configure a shared admin key.

# Optional public URL for canonical links
NEXT_PUBLIC_SITE_URL=

# Optional server-only FX provider override. Defaults to open.er-api.com (no key required).
# Use an HTTPS URL template containing {base}; the key, if needed, is sent as a Bearer token.
NEXVORO_FX_API_URL=
NEXVORO_FX_API_KEY=
